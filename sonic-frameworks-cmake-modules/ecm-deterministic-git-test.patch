diff --git a/tests/KDEFetchTranslations/CMakeLists.txt b/tests/KDEFetchTranslations/CMakeLists.txt
--- a/tests/KDEFetchTranslations/CMakeLists.txt
+++ b/tests/KDEFetchTranslations/CMakeLists.txt
@@ -1,6 +1,13 @@
 cmake_minimum_required(VERSION 3.5)
 project(extra-cmake-modules)
 
+file(COPY "${CMAKE_CURRENT_SOURCE_DIR}/git"
+    DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/mock-bin"
+    FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
+set(saved_path "$ENV{PATH}")
+set(ENV{PATH} "${CMAKE_CURRENT_BINARY_DIR}/mock-bin:$ENV{PATH}")
+set(ENV{ECM_TEST_GIT_MODE} "tracked")
+
 # order is important (install dirs before cmake settings)!
 set(all_kde_modules
     KDEInstallDirs
@@ -21,6 +28,27 @@
 if (NOT ${name} MATCHES ".*/extra-cmake-modules")
     message(FATAL_ERROR "Wrong repository name: ${name}, should match '*/extra-cmake-modules'")
 endif()
+
+set(ENV{ECM_TEST_GIT_MODE} "detached")
+_repository_name(detached_name "${CMAKE_CURRENT_SOURCE_DIR}/../../")
+if (NOT "${detached_name}" STREQUAL "${name}")
+    message(FATAL_ERROR "Detached checkout resolved as ${detached_name}, expected ${name}")
+endif()
+
+set(ENV{ECM_TEST_GIT_MODE} "none")
+_repository_name(archive_name "${CMAKE_CURRENT_SOURCE_DIR}/../../")
+if (NOT "${archive_name}" STREQUAL "${CMAKE_PROJECT_NAME}")
+    message(FATAL_ERROR "Archive fallback resolved as ${archive_name}, expected ${CMAKE_PROJECT_NAME}")
+endif()
+
+set(ENV{ECM_TEST_GIT_MODE} "nonkde")
+_repository_name(fork_name "${CMAKE_CURRENT_SOURCE_DIR}/../../")
+if (NOT "${fork_name}" STREQUAL "${CMAKE_PROJECT_NAME}")
+    message(FATAL_ERROR "Non-KDE fallback resolved as ${fork_name}, expected ${CMAKE_PROJECT_NAME}")
+endif()
+unset(ENV{ECM_TEST_GIT_MODE})
+set(ENV{PATH} "${saved_path}")
+
 add_executable(dummy ../ExecuteKDEModules/main.c)
 ecm_mark_nongui_executable(dummy)
 
diff --git a/tests/KDEFetchTranslations/git b/tests/KDEFetchTranslations/git
new file mode 100644
--- /dev/null
+++ b/tests/KDEFetchTranslations/git
@@ -0,0 +1,25 @@
+#!/bin/sh
+set -eu
+mode=${ECM_TEST_GIT_MODE:-tracked}
+case "$*" in
+    --version)
+        printf '%s\n' 'git version 2.0.0'
+        ;;
+    'rev-parse --symbolic-full-name @{u}')
+        case "$mode" in
+            detached|none) exit 1 ;;
+            *) printf '%s\n' 'refs/remotes/origin/master' ;;
+        esac
+        ;;
+    'remote get-url --all origin')
+        case "$mode" in
+            none) exit 1 ;;
+            nonkde) printf '%s\n' 'https://github.com/Sonic-DE/sonic-frameworks-cmake-modules.git' ;;
+            *) printf '%s\n' 'https://invent.kde.org/frameworks/extra-cmake-modules.git' ;;
+        esac
+        ;;
+    *)
+        printf 'Unexpected git fixture invocation: %s\n' "$*" >&2
+        exit 2
+        ;;
+esac
