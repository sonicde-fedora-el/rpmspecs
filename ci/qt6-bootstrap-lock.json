{
  "purpose": "Pinned EL10 source rebuild cohort for the Qt dependency required by SonicDE. Source records and ordering are not proof that every module has been built or installed.",
  "target_qt_version": "6.11.3",
  "target_release": "1.rytteros%{?dist}",
  "policy": [
    "Use Fedora packaging SOURCE files pinned to recorded commits, not Fedora binary RPMs.",
    "Use official Qt source archives at the recorded SHA256 digests.",
    "Preserve upstream version requirements, hardening, patches and existing verification settings; investigate patch applicability rather than dropping failures.",
    "Build in an isolated EL10 container/buildroot, never dnf-install into the running atomic host.",
    "Resolve and rebuild all required Qt private-ABI consumers before attempting installation."
  ],
